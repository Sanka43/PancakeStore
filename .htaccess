# PancakeStore — Apache/cPanel SEO & performance helpers

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS only on the live domain (skip localhost / XAMPP)
  RewriteCond %{HTTP_HOST} ^(www\.)?pancakestore\.site$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Remove index.html from URLs (subdirectory-safe)
  RewriteCond %{THE_REQUEST} \s/+(.+/)?index\.html[\s?] [NC]
  RewriteRule ^(?:(.+)/)?index\.html$ /$1 [L,R=301]
</IfModule>

# Security / SEO-friendly headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType application/manifest+json "access plus 7 days"
</IfModule>

# Correct MIME types
AddType application/manifest+json .webmanifest
AddType image/webp .webp
